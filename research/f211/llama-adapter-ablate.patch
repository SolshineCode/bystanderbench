diff --git a/src/llama-adapter.cpp b/src/llama-adapter.cpp
index 3e0fe66af..12d940d62 100644
--- a/src/llama-adapter.cpp
+++ b/src/llama-adapter.cpp
@@ -21,7 +21,43 @@ ggml_tensor * llama_adapter_cvec::tensor_for(int il) const {
 
 ggml_tensor * llama_adapter_cvec::apply_to(ggml_context * ctx, ggml_tensor * cur, int  il) const {
     ggml_tensor * layer_dir = tensor_for(il);
-    if (layer_dir != nullptr) {
+    if (layer_dir == nullptr) {
+        return cur;
+    }
+
+    // BystanderBench §F211 patch (NOT upstream). LLAMA_CVEC_MODE selects what the
+    // control vector does. Unset or "add" is the stock behaviour, byte for byte.
+    //   ablate : layer_dir is a UNIT direction u; per token, cur -= (u.cur) u
+    //            (directional ablation / "abliteration" at this layer)
+    //   clamp  : per token, set the projection to LLAMA_CVEC_CLAMP:
+    //            cur += (t - u.cur) u
+    // Layers whose tensor is all zero (absent from the file) are left unchanged in both
+    // modes, since u = 0 makes the correction term zero.
+    static const char * mode_env = getenv("LLAMA_CVEC_MODE");
+    static const std::string mode = mode_env ? mode_env : "add";
+    static const float clamp_t = getenv("LLAMA_CVEC_CLAMP") ? (float) atof(getenv("LLAMA_CVEC_CLAMP")) : 0.0f;
+    static bool logged = false;
+    if (!logged) {
+        LLAMA_LOG_INFO("%s: CVEC_MODE=%s CVEC_CLAMP=%.6f\n", __func__, mode.c_str(), clamp_t);
+        // llama-server filters libllama INFO lines out of its log, so a log line cannot serve as
+        // the launcher's proof. Write a marker from inside this code path instead.
+        if (const char * mk = getenv("LLAMA_CVEC_MARKER")) {
+            if (FILE * f = fopen(mk, "a")) {
+                fprintf(f, "CVEC_MODE=%s CVEC_CLAMP=%.6f il=%d\n", mode.c_str(), clamp_t, il);
+                fclose(f);
+            }
+        }
+        logged = true;
+    }
+
+    if (mode == "ablate" || mode == "clamp") {
+        ggml_tensor * proj = ggml_mul_mat(ctx, layer_dir, cur);              // [1, n_tokens]
+        ggml_tensor * coef = mode == "ablate"
+            ? ggml_scale(ctx, proj, -1.0f)                                   // -p
+            : ggml_scale_bias(ctx, proj, -1.0f, clamp_t);                    // t - p
+        ggml_tensor * delta = ggml_mul(ctx, ggml_repeat(ctx, layer_dir, cur), coef);
+        cur = ggml_add(ctx, cur, delta);
+    } else {
         cur = ggml_add(ctx, cur, layer_dir);
     }
 
