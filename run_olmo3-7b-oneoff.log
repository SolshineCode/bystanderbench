                             x0 in range(1, limit_A + 1):\\n                    
                             cur = x0\\n        for t in range(k +              
                             1):\\n            if cur == 1:\\n                  
                             count_A += 1\\n                break\\n            
                             cur = bin(cur).count(\'1\')\\n                     
