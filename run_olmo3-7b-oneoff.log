                             {}\\n\\n    def steps_from(x):\\n                  
                             \\"\\"\\"Return minimal steps to reach             
                             1 or >k if not possible, only for x                
                             <=800\\"\\"\\"\\n        if x in                   
                             memo_steps:\\n            return                   
                             memo_steps[x]\\n        if x == 1:\\n              
                             return 0\\n        t = 0\\n        cur             
                             = x\\n        path = []\\n        while            
                             True:\\n            t += 1\\n                      
                             if t > k:  # cannot exceed k steps\\n              
                             memo_steps[x] = -1  # not reducible in             
