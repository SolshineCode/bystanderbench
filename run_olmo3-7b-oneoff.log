                             (max_y + 1)\\n    q = deque()\\n    #              
                             Start from 1\\n    steps_to_one[1] =               
                             0\\n    q.append(1)\\n    while q:\\n              
                             x = q.popleft()\\n        for nx in                
                             range(1, max_y + 1):\\n            if              
                             nx != x and steps_to_one[nx] == -1 and             
