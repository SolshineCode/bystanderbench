                             # Actually use standard sieve for                  
                             mu:\\n    mu = [1]*(max_a+1)\\n                    
                             mu[0] = 0\\n    is_composite =                     
                             [False]*(max_a+1)\\n    for p in                   
                             range(2, max_a+1):\\n        if not                
                             is_composite[p]:\\n            for                 
                             multiple in range(p, max_a+1, p):\\n               
                             if multiple % p == 0:\\n                           
