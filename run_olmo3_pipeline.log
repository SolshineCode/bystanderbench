                             if spf[j] == 0:\\n                                 
                             spf[j] = i\\n    mu = [1]*(max_a+1)\\n             
                             mu[0] = 0\\n    for i in range(1,                  
                             max_a+1):\\n        x = i\\n        res            
                             = 1\\n        last_p = -1\\n                       
                             while x > 1:\\n            p =                     
                             spf[x]\\n            if p == last_p:\\n            
                             res = 0\\n                break\\n                 
                             res *= -1\\n            last_p = p\\n              
                             x //= p\\n        mu[i] = res\\n    #              
                             Now for each d from 1..200, count                  
                             numbers in nums divisible by d\\n                  
                             cnt = defaultdict(int)\\n    for x in              
                             nums:\\n        for d in range(1,                  
                             201):\\n            if x % d == 0:\\n              
                             cnt[d] += 1\\n    # For each possible              
                             g, inclusion-exclusion to get exact                
                             subsets with gcd==g\\n    from math                
                             import gcd as _gcd\\n    subset_counts             
                             = defaultdict(int)\\n    for g in                  
                             range(1, 201):\\n        m = [x // g               
                             for x in nums if x % g == 0]\\n                    
                             n = len(m)\\n        if n == 0:\\n                 
                             continue\\n        total = 0\\n                    
                             # For each t dividing some element in              
                             m, inclusion-exclusion via mu\\n                   
                             max_m = max(m) if m else 0\\n                      
                             divs = set()\\n        for v in m:\\n              
                             i = 1\\n            while i <= v:\\n               
                             divs.add(i)\\n                if v % i             
                             == 0:\\n                    v //= i\\n             
                             else:\\n                    break\\n               
                             # For each d in divs, compute how many             
                             elements in m are divisible by d\\n                
                             from collections import defaultdict\\n             
                             freq = defaultdict(int)\\n        for v            
                             in m:\\n            for d in divs:\\n              
                             if v % d == 0:\\n                                  
                             freq[d] += 1\\n        # Now                       
                             inclusion-exclusion: number of                     
                             non-empty subsets of m with gcd 1\\n               
                             # ans = sum_{k in divs} mu(k) * 2^{c[k]            
                             - 1}, where c[k] is count of elements              
                             in m divisible by k\\n        ans =                
