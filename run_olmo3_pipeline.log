                             [1]*(max_num+1)\\n                for p            
                             in range(2, max_num+1):\\n                         
                             if not is_squarefree[p]:\\n                        
                             continue\\n                    for                 
                             multiple in range(p, max_num+1, p):\\n             
                             mu[multiple] *= -1\\n                              
