                             c = freq.get(k,0)\\n            term =             
                             (pow(2, c-1, MOD) if c > 0 else 0) *               
                             mu[k]\\n            ans = (ans + term)             
                             % MOD\\n        # Now the number of                
                             subsets of original nums whose elements            
