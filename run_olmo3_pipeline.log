                             new_dp[ng] += c\\n                #                
                             subtract the empty set (if counted)\\n             
                             total =0\\n                for g in                
                             dp:\\n                    if g ==1:\\n             
                             total += dp[g] - (1 if 0 in dp else 0)             
                             # not sure\\n                #                     
                             Alternatively, better to use a set of              
