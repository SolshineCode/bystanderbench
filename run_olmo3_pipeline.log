                             # We\'ll do a standard binary digit                
                             DP\\n        nbits = len(bin(X)) - 2  #            
                             excluding \'0b\'\\n        # But X may             
                             have leading zeros in the bit                      
                             representation to match length\\n                  
                             # Let\'s format X to have length                   
                             nbits\\n        bit_str =                          
                             bin(X)[2:].zfill(nbits)\\n        from             
                             functools import lru_cache\\n                      
                             @lru_cache(maxsize=None)\\n        def             
                             dp(pos, tight, cnt):\\n            if              
                             pos == nbits:\\n                return             
                             1 if (cnt == c) else 0\\n                          
                             res = 0\\n            max_d =                      
                             int(bit_str[pos]) if tight else 1\\n               
                             for d in range(0, max_d + 1):\\n                   
                             new_tight = tight and (d == max_d)\\n              
                             new_cnt = cnt + (d == 1)\\n                        
                             if new_cnt > c:\\n                                 
                             continue\\n                res +=                  
                             dp(pos + 1, new_tight, new_cnt)\\n                 
                             return res\\n        return dp(0, True,            
                             0)\\n\\n# However, the above                       
                             count_up_to may be slow for very large             
                             X, but for X=800 or m (which in the                
                             test case with answer 800 has m=1023)              
                             it\'s fine.\\n\\n# But note the test               
                             case \\"111\\" (m=7), k=1:\\n#                     
                             limit_A = min(7,800)=7\\n#   count_A:              
