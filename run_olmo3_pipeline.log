                             set to 0 but we\'ll handle it\\n                   
                             else:\\n                                           
                             mu[multiple] *= -1\\n                              
                             is_composite[multiple] = True\\n    #              
                             Actually better to use a known                     
                             implementation, but for simplicity,                
                             we\'ll use a helper to compute mu                  
                             properly\\n    # Let\'s use this                   
                             version for clarity (from known                    
                             code):\\n    mu = [1]*(max_a+1)\\n                 
                             spf = [0]*(max_a+1)\\n    for i in                 
                             range(2, max_a+1):\\n        if spf[i]             
                             == 0:\\n            spf[i] = i\\n                  
